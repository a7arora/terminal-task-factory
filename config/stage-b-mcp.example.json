{
  "reference": {
    "command": "./.venv/bin/python",
    "args": [
      "-m",
      "taskforge.reference_server"
    ],
    "env": {
      "TASKFORGE_REFERENCE_CATALOG": "${TASKFORGE_REFERENCE_CATALOG}"
    }
  },
  "github": {
    "command": "docker",
    "args": [
      "run",
      "-i",
      "--rm",
      "-e",
      "GITHUB_PERSONAL_ACCESS_TOKEN",
      "-e",
      "GITHUB_READ_ONLY",
      "-e",
      "GITHUB_TOOLSETS",
      "-e",
      "GITHUB_TOOLS",
      "ghcr.io/github/github-mcp-server@sha256:250bc6ce70788207608ef74cef4397230ff2e8481218da74d6093e4bd9101132"
    ],
    "env": {
      "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}",
      "GITHUB_READ_ONLY": "1",
      "GITHUB_TOOLSETS": "repos",
      "GITHUB_TOOLS": "search_repositories,get_file_contents,get_commit"
    },
    "allowed_tools": [
      "search_repositories",
      "get_file_contents",
      "get_commit"
    ]
  }
}
