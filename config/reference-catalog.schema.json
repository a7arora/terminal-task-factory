{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskForge visible reference-task catalog",
  "type": "object",
  "required": ["dataset_version", "tasks"],
  "properties": {
    "dataset_version": {"const": "terminal-bench/terminal-bench@4.0.0"},
    "source_uri": {"type": "string"},
    "access_policy": {"type": "string"},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_id", "category", "subcategory", "description"],
        "properties": {
          "task_id": {"type": "string"},
          "title": {"type": "string"},
          "category": {"type": "string"},
          "subcategory": {"type": "string"},
          "description": {"type": "string", "minLength": 1},
          "difficulty_metadata": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
